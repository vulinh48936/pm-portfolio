# In-house LLM, OpenAI-compatible: {LLM_BASE_URL}/chat/completions
# Needed for Generate and free-form explanations; no cloud fallback.
LLM_BASE_URL=http://llm.internal:8000/v1
LLM_MODEL=qwen2.5-coder-32b
LLM_API_KEY=
LLM_TIMEOUT=180

# CCP: returns JSON whose "Content" field is the Data Platform token
CCP_URL=https://ccp.internal/AIMWebService/api/Accounts?AppID=...&Safe=APIToken&Object=...
CCP_TOKEN_TTL=86400
CCP_VERIFY_SSL=1

# Data Platform, daily OHLCV; page numbering starts at 1
MARKET_API_URL=http://datalake-serving-gateway.internal/api/ohlcv
MARKET_TOKEN_HEADER=Authorization
MARKET_TOKEN_PREFIX=Bearer
MARKET_PAGE_SIZE=1000
MARKET_INDEX_TICKER=VNINDEX
MARKET_HISTORY_START=2018-10-01
MARKET_API_TIMEOUT=60

# Daily job. These are only first-run defaults; edit the schedule in the Operations tab.
SCHEDULER_ENABLED=1
SCHEDULER_TIME=16:00
SCHEDULER_TZ=Asia/Ho_Chi_Minh
SCHEDULER_WEEKDAYS_ONLY=1
JOB_DATA_DAY=T

# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
