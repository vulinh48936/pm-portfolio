# The official nginx image runs envsubst over /etc/nginx/templates/*.template at startup,
# substituting only names present in the environment. ${API_UPSTREAM} is replaced;
# $uri, $host and the other nginx variables are left alone.

server {
    listen 8080;
    server_name _;

    # Port 8080, not 80, so the container can also run as a non-root user: switching to
    # nginxinc/nginx-unprivileged needs no change here.
    root /usr/share/nginx/html;
    index index.html;

    # Single-page app: anything that is not a static file returns index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Assets carry a content hash, so they can be cached forever; index.html must not be,
    # or users keep the old build after a deploy.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Long timeouts: a backtest or an LLM call can take minutes.
    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_buffering off;
    }

    client_max_body_size 8m;      # enough for strategy code and a pasted weight table
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;
}
